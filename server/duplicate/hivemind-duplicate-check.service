[Unit]
Description=Hivemind daily internal and public duplicate check
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/absolute/bintable/hivemind-checkout
ExecStart=/usr/bin/node /absolute/bintable/hivemind-checkout/server/duplicate/worker.mjs
Environment=HIVEMIND_VERIFIER_SOCKET=/absolute/private/data-directory/verifier.sock
Environment=HIVEMIND_CODEX_CLI=/usr/bin/codex
Environment=HIVEMIND_DUPLICATE_WORK_ROOT=/absolute/bintable/duplicate-work
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=6h

