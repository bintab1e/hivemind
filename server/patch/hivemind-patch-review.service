[Unit]
Description=Hivemind Sashiko patch review worker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/absolute/bintable/hivemind-checkout
ExecStart=/usr/bin/node /absolute/bintable/hivemind-checkout/server/patch/worker.mjs
Environment=HIVEMIND_VERIFIER_SOCKET=/absolute/private/data-directory/verifier.sock
Environment=HIVEMIND_SASHIKO_CLI=/absolute/bintable/sashiko/bin/sashiko-cli
Environment=HIVEMIND_SASHIKO_CONFIG_DIR=/absolute/bintable/sashiko/config
Environment=HIVEMIND_PATCH_WORK_ROOT=/absolute/bintable/patch-work
Environment=HIVEMIND_PATCH_REPO_RC=/absolute/kernel-rc
Environment=HIVEMIND_PATCH_REPO_MAINLINE=/absolute/kernel-stable
UMask=0077
NoNewPrivileges=true
Restart=always
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=default.target
