{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "reason", "trace_line", "source_path", "source_line", "poc_line"],
  "properties": {
    "verdict": { "type": "string", "enum": ["supports", "refutes", "uncertain"] },
    "reason": { "type": "string" },
    "trace_line": { "type": ["string", "null"] },
    "source_path": { "type": ["string", "null"] },
    "source_line": { "type": ["integer", "null"] },
    "poc_line": { "type": ["integer", "null"] }
  }
}
