{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "reason", "comparison"],
  "properties": {
    "verdict": { "type": "string", "enum": ["same", "different", "uncertain"] },
    "reason": { "type": "string" },
    "comparison": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["reachable_path", "faulty_operation", "violated_invariant", "defenses", "existing_quote", "new_quote", "source_path", "source_line"],
      "properties": {
        "reachable_path": { "type": "string" },
        "faulty_operation": { "type": "string" },
        "violated_invariant": { "type": "string" },
        "defenses": { "type": "string" },
        "existing_quote": { "type": "string" },
        "new_quote": { "type": "string" },
        "source_path": { "type": "string" },
        "source_line": { "type": "integer" }
      }
    }
  }
}
