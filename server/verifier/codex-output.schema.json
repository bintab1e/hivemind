{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "reason", "integrity", "normalized", "proof"],
  "properties": {
    "verdict": { "type": "string", "enum": ["likely", "unlikely", "uncertain"] },
    "reason": { "type": "string" },
    "integrity": { "type": "object", "additionalProperties": false,
      "required": ["verdict", "reason", "admin_action_required"], "properties": {
        "verdict": { "type": "string", "enum": ["clear", "suspect", "uncertain"] },
        "reason": { "type": "string" },
        "admin_action_required": { "type": ["boolean", "null"] }
      }
    },
    "proof": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["entry", "flaw", "impact", "defenses", "poc", "log"],
      "properties": {
        "entry": { "$ref": "#/$defs/sourceAnchor" },
        "flaw": { "$ref": "#/$defs/sourceAnchor" },
        "impact": { "$ref": "#/$defs/sourceAnchor" },
        "defenses": { "$ref": "#/$defs/sourceAnchor" },
        "poc": { "type": "object", "additionalProperties": false,
          "required": ["line", "explanation"],
          "properties": { "line": { "type": "integer", "minimum": 1 }, "explanation": { "type": "string" } }
        },
        "log": { "type": "object", "additionalProperties": false,
          "required": ["index", "line", "explanation"],
          "properties": { "index": { "type": "integer", "minimum": 0 }, "line": { "type": "integer", "minimum": 1 }, "explanation": { "type": "string" } }
        }
      }
    },
    "normalized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "report", "file_path", "code_refs", "source_evidence", "options", "permission", "nfs_version", "pre_auth", "vulnerability_type", "found_date", "claimed_impacts", "poc_file_index", "poc_language", "build_command", "run_command", "log_file_indexes"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "report": { "type": ["string", "null"] },
        "file_path": { "type": ["string", "null"] },
        "code_refs": { "type": "array", "items": { "type": "string" } },
        "source_evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "line"], "properties": { "path": { "type": "string" }, "line": { "type": "integer" } } } },
        "options": { "type": ["string", "null"] },
        "permission": { "type": ["string", "null"] },
        "nfs_version": { "type": ["string", "null"] },
        "pre_auth": { "type": ["object", "null"], "additionalProperties": false, "required": ["source_path", "source_line", "poc_line"], "properties": { "source_path": { "type": "string" }, "source_line": { "type": "integer" }, "poc_line": { "type": "integer" } } },
        "vulnerability_type": { "type": ["string", "null"] },
        "found_date": { "type": ["string", "null"] },
        "claimed_impacts": {
          "type": "array",
          "items": { "type": "string", "enum": ["kasan_read", "kasan_write", "controlled_read", "controlled_write", "rce", "lpe", "info_leak"] }
        },
        "poc_file_index": { "type": ["integer", "null"] },
        "poc_language": { "type": ["string", "null"], "enum": ["c", null] },
        "build_command": { "type": ["string", "null"] },
        "run_command": { "type": ["string", "null"] },
        "log_file_indexes": { "type": "array", "items": { "type": "integer" } }
      }
    }
  },
  "$defs": {
    "sourceAnchor": { "type": "object", "additionalProperties": false,
      "required": ["path", "line", "explanation"],
      "properties": {
        "path": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "explanation": { "type": "string" }
      }
    }
  }
}
